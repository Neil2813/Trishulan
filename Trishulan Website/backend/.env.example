# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:password@localhost:5432/trishulan_db?schema=public"

# Firebase Authentication project ID (must match the frontend Firebase project)
FIREBASE_PROJECT_ID=""

# JWT secret (change in production!)
JWT_SECRET="your-super-secret-jwt-key"

# Server configuration
PORT=5000
NODE_ENV=development

# Frontend URL (for CORS)
FRONTEND_URL="http://localhost:3000"

# GSTIN verification provider (server-side only)
GST_API_URL="https://api.gstincheck.co.in/v1/verify/"
GST_API_KEY="replace-with-provider-api-key"

# PAN verification provider (server-side only)
PAN_API_URL="https://api.sandbox.co.in"
PAN_API_KEY="replace-with-provider-api-key"
PAN_API_SECRET="replace-with-provider-api-secret"

# India Post PIN lookup endpoint (server-side only; no API key required)
POSTAL_PIN_API_URL="https://api.postalpincode.in/pincode/"
