{
  "compilerOptions": {
    "target":           "ES2020",
    "module":           "esnext",
    "moduleResolution": "bundler",
    "lib":              ["ES2020"],
    "allowJs":          true,
    "skipLibCheck":     true,
    "strict":           true,
    "noEmit":           true,
    "esModuleInterop":  true,
    "resolveJsonModule":true,
    "isolatedModules":  true,
    "outDir":           "./dist"
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
