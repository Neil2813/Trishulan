{
  "name": "trishulan-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:frontend": "next dev",
    "dev:backend": "tsx watch server/index.ts",
    "server": "tsx server/index.ts",
